# Environment reference — example values only, never real secrets.
#
# Precedence, highest first: process env (systemd unit or shell) → .env.local
# (Next's own file, this checkout) → $JAXOS_HOME/.env (default ~/.jax-os/.env,
# mode 0600). Defined once here; no other tracked file repeats it.

# --- Secrets (6) — fill these in $JAXOS_HOME/.env, never in .env.local ------

# Linear API key — gates the `linear` integration in /settings.
LINEAR_API_KEY=lin_example_key

# OpenCode GO usage token — feeds the OpenCode usage meter (switch the OpenCode agent on in /settings).
OPENCODE_GO_API_KEY=opencode_example_key

# Notification webhook target, HMAC-signed with the secret below — gates the
# `webhook` integration in /settings.
NOTIFICATION_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/example

# Signing secret for the notification webhook — gates the `webhook`
# integration in /settings.
NOTIFICATION_WEBHOOK_SECRET=example_webhook_secret

# TypeSafe (Jev) key for the message classifier — gates the `classifier`
# integration in /settings.
TYPESAFE_API=example_typesafe_key

# OpenRouter key for the classifier's fallback model (used when the Jev call
# fails) — gates the `classifier` integration in /settings.
OPENROUTER_API_KEY_BUILDER=example_openrouter_key

# --- Runtime settings (3) — not secrets, keep out of $JAXOS_HOME/.env ------

# ttyd read-only / read-write listeners for the tmux viewer; put these in
# .env.local.
TTYD_RO_URL=http://127.0.0.1:7681
TTYD_RW_URL=http://127.0.0.1:7682

# Port `next start` binds — the systemd unit's Environment= line, or exported
# in the shell for `PORT=3100 pnpm start`.
PORT=3100
